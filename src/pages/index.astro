---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/footer.astro';
import Nav from '../components/nav.astro';
import { Image } from 'astro:assets';
import ProfileImgReal from '../assets/hjeum_profile_real.png';
import CanvasBusinessCard from '../components/canvasBusinessCard.astro';
import projects from '../data/projects.json';
import skills from '../data/skills.json';
---

<Layout title='Abstract of HoJoon Eum'>
  <Nav />
  <main>
    <section id='who-am-i'>
      <article class='description'>
        <p>
          こんにちは、陰昊俊（ウムホジュン）と申します。ソフトウェアエンジニアとして活動しております。
          このウェブサイトは、私のテックブログや趣味ブログとは異なる形式で、自分の考えを伝えるために作成しました。テックブログでは、技術や技術に関連する概念的な話題について発信しています。また、趣味ブログでは、私の趣味活動について紹介しています。
          しかし、ここでは単なるブログシステムでは表現できない内容を、ウェブページを直接作成することで伝えたいと考えています。私の経験や伝えたい思いを、より自由な形で表現する場として、このサイトを運営しております。どうぞよろしくお願いいたします。
        </p>
      </article>
      <Image
        id='profile-real'
        src={ProfileImgReal}
        alt='hojooneum in Hokkaido'
      />
    </section>
    <CanvasBusinessCard />
    <div>
      <section
        id='what-i-do'
        class='card'>
        <div>
          <h3>プロジェクト</h3>
          <p>
            *今サービス中ですので、ソースコードの公開ができないプロジェクトは、demo(デモ)をご覧ください。
          </p>
          <div id='projects'>
            {
              projects.projects.map((project) => (
                <div class='project-card'>
                  <h4>{project.title}</h4>
                  <p>{project.description}</p>
                  <p>
                    <strong>技術スタック:</strong>{' '}
                    {project.techStack.join(', ')}
                  </p>
                  <p>
                    <strong>課題と解決策:</strong> {project.problemAndSolution}
                  </p>

                  <div class='buttons'>
                    {project.link ? (
                      <a
                        href={project.link}
                        target='_blank'>
                        <button>詳細</button>
                      </a>
                    ) : (
                      <button disabled>詳細</button>
                    )}

                    {project.demo ? (
                      <a
                        href={project.demo}
                        target='_blank'>
                        <button>デモ</button>
                      </a>
                    ) : (
                      <button disabled>デモ</button>
                    )}
                  </div>
                </div>
              ))
            }
          </div>
        </div>
        <article id='skills-container'>
          <h3>スキル</h3>
          <span class='skill-notation'
            >最上:上級の技術の中で最も自信がある技術</span
          >
          <span class='skill-notation'
            >上:専門知識があり、多数の使用経験がある</span
          >
          <span class='skill-notation'>中:専門知識があり、使用経験がある</span>
          <span class='skill-notation'>下:使用法がわかり、専門知識はない</span>
          <table>
            <thead>
              <tr>
                <th>名前</th>
                <th>バージョン</th>
                <th>目的</th>
                <th>レベル</th>
              </tr>
            </thead>
            <tbody>
              {
                skills.map((skill) => (
                  <tr>
                    <td>{skill.name}</td>
                    <td>{skill.version}</td>
                    <td>{skill.purpose}</td>
                    <td>{skill.level}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </article>
      </section>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  ul {
    margin-top: -1rem;
    margin-left: -2rem;
  }
  .card {
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    padding: calc(var(--Thickness-Thick) * 1px);
  }
  .card article {
    text-align: start;
  }
  #who-am-i {
    width: 100%;
    display: flex;
    flex-flow: wrap;
    justify-content: center;
    align-items: stretch;
    padding-bottom: 2px;
    border-bottom: 2px solid black;
    margin-bottom: 2rem;
  }
  #who-am-i .description {
    flex: 3;
    text-align: start;
    margin: auto;
    padding: calc(var(--Thickness-Thick) * 1px);
  }
  @media screen and (max-width: 600px) {
    #who-am-i {
      flex-direction: column-reverse;
      align-items: center;
      margin-bottom: 2rem;
    }
    #who-am-i .description {
      margin: unset;
      max-width: 100%;
    }
    #who-am-i img {
      padding: 5px;
    }
  }
  #who-am-i img {
    max-width: 200px;
    min-width: 30px;
    height: auto;
    aspect-ratio: 1 / 1;
  }
  #projects {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1rem;
    justify-content: center;
    align-items: stretch;
  }
  .project-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: start;
    width: 100%;
    height: 100%;
    min-height: 350px; /* 카드의 최소 높이 지정 */
    max-width: 400px; /* 카드의 최대 너비 지정 */
    padding: 1rem;
    color: black;
    background-color: white;
    border: 1px solid darkgrey;
    box-shadow: 2px 2px 2px rgba(0, 0, 0, 0.1);
  }
  .project-card h4 {
    font-weight: 400;
    margin: 1rem 0;
  }
  .project-card button {
    padding: 0.5rem 1rem;
    background-color: orange;
    color: #000;
    border: none;
    border-radius: 5px;
    cursor: pointer;
  }
  .project-card button:hover {
    background-color: #ff8c00;
  }
  #skills-container {
    width: 100%;
  }
  #skills-container > .skill-notation {
    font-size: 0.8rem;
    width: fit-content;
    display: block;
    margin: 5px;
  }
  table {
    width: 100%;
    border-collapse: collapse;
  }
  table,
  th,
  td {
    border: 1px solid black;
  }
  th,
  td {
    padding: 0.5rem;
  }

  .project-card {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: start;
    padding: 1rem;
    color: black;
    background-color: white;
    border: 1px solid darkgrey;
    box-shadow: 2px 2px 2px rgba(0, 0, 0, 0.1);
  }

  .project-card h4 {
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  .project-card p {
    margin: 0.2rem 0;
  }

  .project-card .buttons {
    display: flex;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .project-card button {
    padding: 0.5rem 1rem;
    background-color: orange;
    color: #000;
    border: none;
    border-radius: 5px;
    cursor: pointer;
    transition: background 0.3s ease-in-out;
  }

  .project-card button:hover {
    background-color: #ff8c00;
  }

  .project-card button:disabled {
    background-color: lightgray;
    color: #666;
    cursor: not-allowed;
  }
</style>
